---
// Deep Link Redirect Page
// This page handles app deep linking for mobile devices and redirects users appropriately

// Configuration - Update these values for your app
const config = {
  appName: "Your App Name",
  appTagline: "Your App Tagline",
  description: "Your app description here - explain what your app does",

  // Deep link scheme (e.g., "myapp://")
  appScheme: "yourappscheme",

  // Android package name for Intent URLs
  androidPackage: "com.yourcompany.yourapp",

  // Store URLs
  appStoreUrl: "https://apps.apple.com/us/app/your-app-name/id123456789",
  playStoreUrl: "https://play.google.com/store/apps/details?id=com.yourcompany.yourapp",

  // Fallback website URL for desktop users
  websiteUrl: "https://yourapp.com",

  // OG Image URL
  ogImageUrl: "https://yourapp.com/og-image.png",

  // Twitter/X handle (without @)
  twitterHandle: "yourtwitterhandle",
};

// Get the current URL path for deep link construction
const currentPath = Astro.url.pathname + Astro.url.search;
const canonicalUrl = Astro.url.href;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{config.appName} - Redirecting...</title>

    <!-- SEO Meta Tags -->
    <meta name="description" content={config.description} />
    <meta name="robots" content="noindex, nofollow" />

    <!-- Open Graph Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${config.appName} - ${config.appTagline}`} />
    <meta property="og:description" content={config.description} />
    <meta property="og:image" content={config.ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={config.appName} />

    <!-- Twitter/X Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={`@${config.twitterHandle}`} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body>
    <div class="container">
      <h1>{config.appName}</h1>
      <p>Redirecting you to the right place...</p>
      <div class="spinner" aria-label="Loading"></div>
      <div class="manual-link">
        Not redirecting? <a href="#" id="manual-redirect">Click here</a>
      </div>
    </div>

    <script define:vars={{ config, currentPath }}>
      (function() {
        "use strict";

        /**
         * Detect the user's platform based on user agent
         * @returns {"ios" | "android" | "web"}
         */
        function detectPlatform() {
          const userAgent = navigator.userAgent || navigator.vendor || window.opera || "";

          // iOS detection
          if (/iPad|iPhone|iPod/.test(userAgent) && !window.MSStream) {
            return "ios";
          }

          // Android detection
          if (/android/i.test(userAgent)) {
            return "android";
          }

          return "web";
        }

        /**
         * Build the deep link path from the current URL
         * @returns {string}
         */
        function getDeepLinkPath() {
          // Remove the /link prefix and leading slash
          let path = currentPath.replace(/^\/link\/?/, "");
          return path || "";
        }

        /**
         * Create the appropriate deep link URL for the platform
         * @param {"ios" | "android" | "web"} platform
         * @returns {string}
         */
        function getDeepLinkUrl(platform) {
          const path = getDeepLinkPath();

          if (platform === "android") {
            // Use Android Intent URL for better reliability
            const intentUrl = `intent://${path}#Intent;` +
              `scheme=${config.appScheme};` +
              `package=${config.androidPackage};` +
              `S.browser_fallback_url=${encodeURIComponent(config.playStoreUrl)};` +
              `end`;
            return intentUrl;
          }

          // iOS and fallback: use custom scheme
          return `${config.appScheme}://${path}`;
        }

        /**
         * Get the store URL for the platform
         * @param {"ios" | "android" | "web"} platform
         * @returns {string}
         */
        function getStoreUrl(platform) {
          if (platform === "ios") {
            return config.appStoreUrl;
          }
          if (platform === "android") {
            return config.playStoreUrl;
          }
          return config.websiteUrl;
        }

        /**
         * Attempt to redirect to the app
         */
        function attemptAppRedirect() {
          const platform = detectPlatform();

          // Desktop users go straight to website
          if (platform === "web") {
            window.location.href = config.websiteUrl;
            return;
          }

          const deepLink = getDeepLinkUrl(platform);

          if (platform === "android") {
            // Android Intent URLs handle fallback automatically
            window.location.href = deepLink;
            return;
          }

          // iOS: Try the custom scheme with fallback
          const startTime = Date.now();
          let didOpenApp = false;

          // Listen for visibility change (indicates app opened)
          function handleVisibilityChange() {
            if (document.hidden || document.visibilityState === "hidden") {
              didOpenApp = true;
            }
          }

          document.addEventListener("visibilitychange", handleVisibilityChange);

          // Try to open the app
          window.location.href = deepLink;

          // Fallback to App Store after timeout
          setTimeout(function() {
            document.removeEventListener("visibilitychange", handleVisibilityChange);

            // If we're still here and the app didn't open, redirect to store
            if (!didOpenApp && !document.hidden) {
              // Check if enough time has passed (app launch takes ~1-2s)
              const elapsed = Date.now() - startTime;
              if (elapsed < 3000) {
                window.location.href = config.appStoreUrl;
              }
            }
          }, 2000);
        }

        // Set up manual redirect link
        const manualLink = document.getElementById("manual-redirect");
        if (manualLink) {
          manualLink.addEventListener("click", function(e) {
            e.preventDefault();
            attemptAppRedirect();
          });
        }

        // Auto-redirect after a short delay to show the loading state
        setTimeout(attemptAppRedirect, 800);
      })();
    </script>
  </body>
</html>

<style>
  body {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: #fff;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
  }

  .container {
    text-align: center;
    padding: 2rem;
    max-width: 400px;
  }

  h1 {
    font-size: 1.75rem;
    margin-bottom: 0.5rem;
    font-weight: 600;
  }

  p {
    font-size: 1rem;
    opacity: 0.9;
    margin-bottom: 1.5rem;
  }

  .spinner {
    border: 3px solid rgba(255, 255, 255, 0.3);
    border-top: 3px solid #fff;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    animation: spin 1s linear infinite;
    margin: 1.5rem auto;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  .manual-link {
    margin-top: 2rem;
    font-size: 0.875rem;
    opacity: 0.8;
  }

  .manual-link a {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .manual-link a:hover {
    opacity: 0.9;
  }
</style>
