---
import { siteConfig } from "../lib/site-config";

const canonicalUrl = Astro.url.href;
const pageTitle = "Reset Your Password";
const appName = siteConfig.appName;
const ogImageUrl = siteConfig.ogImageUrl;
const openAppUrl = `${siteConfig.appScheme}://`;
const supabaseUrl = siteConfig.supabaseUrl;
const supabaseAnonKey = siteConfig.supabaseAnonKey;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>

    <meta name="description" content="Reset your Mosayic password." />
    <meta name="robots" content="noindex, nofollow" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${appName} - Password Reset`} />
    <meta property="og:description" content="Reset your Mosayic password." />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={appName} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;600&display=swap"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body>
    <main class="card">
      <div class="brand">{appName}</div>
      <h1 id="heading">Reset your password</h1>
      <p class="lead" id="lead">Choose a new password for your account.</p>

      <form id="reset-form" class="form" novalidate>
        <label class="field">
          <span>New password</span>
          <div class="input-wrap">
            <input
              id="password"
              name="password"
              type="password"
              minlength="8"
              autocomplete="new-password"
              placeholder="At least 8 characters"
              required
            />
            <button type="button" class="ghost" data-toggle="password">Show</button>
          </div>
        </label>

        <label class="field">
          <span>Confirm password</span>
          <div class="input-wrap">
            <input
              id="confirm-password"
              name="confirmPassword"
              type="password"
              minlength="8"
              autocomplete="new-password"
              placeholder="Re-enter your password"
              required
            />
            <button type="button" class="ghost" data-toggle="confirm-password">Show</button>
          </div>
        </label>

        <button class="primary" type="submit">Reset password</button>
      </form>

      <div id="success-card" class="success-card" hidden>
        <svg class="tick-icon" viewBox="0 0 52 52" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="26" cy="26" r="25" stroke="#2f7a3e" stroke-width="2" />
          <path class="tick-path" d="M15 27l7 7 15-15" stroke="#2f7a3e" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <h2 class="success-title">Password updated</h2>
        <p class="success-text">Your password has been changed successfully. You can now sign in with your new password.</p>
        <a class="success-action" href={openAppUrl}>Open the app</a>
      </div>

      <p id="status" class="status" role="status" aria-live="polite"></p>
      <p class="meta" id="meta">This link expires shortly after it is sent.</p>
    </main>

    <script
      id="supabase-config"
      type="application/json"
      set:html={JSON.stringify({ supabaseUrl, supabaseAnonKey })}
    />

    <script type="module">
      import { createClient } from "@supabase/supabase-js";

      const { supabaseUrl, supabaseAnonKey } = JSON.parse(
        document.getElementById("supabase-config").textContent
      );

      const statusEl = document.getElementById("status");
      const form = document.getElementById("reset-form");
      const passwordInput = document.getElementById("password");
      const confirmInput = document.getElementById("confirm-password");
      const successCard = document.getElementById("success-card");
      const metaEl = document.getElementById("meta");
      const headingEl = document.getElementById("heading");
      const leadEl = document.getElementById("lead");
      const submitBtn = form.querySelector("button[type='submit']");

      const supabase = createClient(supabaseUrl, supabaseAnonKey);

      let recoveryReady = false;

      function setStatus(message, tone = "info") {
        statusEl.textContent = message;
        statusEl.dataset.tone = tone;
      }

      function showSuccess() {
        headingEl.hidden = true;
        leadEl.hidden = true;
        form.hidden = true;
        statusEl.hidden = true;
        metaEl.hidden = true;
        successCard.hidden = false;
      }

      function togglePassword(targetId, button) {
        const input = document.getElementById(targetId);
        if (!input) return;
        const isPassword = input.type === "password";
        input.type = isPassword ? "text" : "password";
        button.textContent = isPassword ? "Hide" : "Show";
      }

      document.querySelectorAll("[data-toggle]").forEach((button) => {
        button.addEventListener("click", (e) => {
          e.preventDefault();
          togglePassword(button.dataset.toggle, button);
        });
      });

      // Let Supabase auto-detect recovery tokens from the URL hash.
      // Listen for the PASSWORD_RECOVERY event to know the session is ready.
      supabase.auth.onAuthStateChange((event, _session) => {
        if (event === "PASSWORD_RECOVERY") {
          recoveryReady = true;
        }
      });

      // Check if URL has recovery params at all (for immediate invalid-link feedback)
      const hashParams = new URLSearchParams(window.location.hash.replace(/^#/, ""));
      const queryParams = new URLSearchParams(window.location.search);
      const type = hashParams.get("type") || queryParams.get("type");
      const hasToken = hashParams.get("access_token") || queryParams.get("access_token");

      if (!hasToken || type !== "recovery") {
        setStatus("This reset link is missing or expired. Request a new one.", "error");
        submitBtn.disabled = true;
      }

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        const password = passwordInput.value.trim();
        const confirm = confirmInput.value.trim();

        if (password.length < 8) {
          setStatus("Password must be at least 8 characters.", "error");
          return;
        }

        if (password !== confirm) {
          setStatus("Passwords do not match.", "error");
          return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = "Updating…";
        setStatus("Updating your password…", "info");

        // If the auth state change hasn't fired yet, check for an existing session
        if (!recoveryReady) {
          const { data: { session } } = await supabase.auth.getSession();
          if (!session) {
            setStatus("This reset link is no longer valid. Request a new one.", "error");
            submitBtn.disabled = false;
            submitBtn.textContent = "Reset password";
            return;
          }
        }

        const { error } = await supabase.auth.updateUser({ password });
        if (error) {
          setStatus("We couldn't reset your password. Please try again.", "error");
          submitBtn.disabled = false;
          submitBtn.textContent = "Reset password";
          return;
        }

        showSuccess();
      });
    </script>
  </body>
</html>

<style>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  :root {
    color-scheme: light;
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    font-family: "Space Grotesk", "Helvetica Neue", Arial, sans-serif;
    background: radial-gradient(circle at top, #f7f2e8, #e6ddcf);
    color: #1d1b16;
    overflow-x: hidden;
  }

  .card {
    width: min(520px, 92vw);
    background: #fffaf0;
    border: 1px solid #e4d6c3;
    border-radius: 24px;
    padding: 2.5rem;
    box-shadow: 0 20px 50px rgba(41, 29, 14, 0.12);
  }

  .brand {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-weight: 600;
    color: #78624a;
  }

  h1 {
    margin: 1rem 0 0.5rem;
    font-size: clamp(1.8rem, 2vw + 1.2rem, 2.4rem);
  }

  .lead {
    margin: 0 0 2rem;
    color: #4b3d2b;
  }

  .form {
    display: grid;
    gap: 1.25rem;
  }

  .field {
    display: grid;
    gap: 0.5rem;
    font-weight: 600;
  }

  .field span {
    font-size: 0.95rem;
    color: #2e2214;
  }

  .input-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: #fdf7ea;
    border: 1px solid #ead9c2;
    border-radius: 16px;
    padding: 0.6rem 0.8rem;
  }

  input {
    flex: 1;
    min-width: 0;
    border: none;
    background: transparent;
    font-size: 1rem;
    color: #1d1b16;
    outline: none;
  }

  input::placeholder {
    color: #9a846c;
  }

  .ghost {
    border: none;
    background: transparent;
    color: #6f5a42;
    font-weight: 600;
    cursor: pointer;
  }

  .primary {
    border: none;
    border-radius: 999px;
    padding: 0.9rem 1.8rem;
    font-weight: 600;
    font-size: 1rem;
    background: #2e2214;
    color: #fdf5e6;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 12px 20px rgba(46, 34, 20, 0.25);
  }

  .primary:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    box-shadow: none;
  }

  .status {
    min-height: 1.5rem;
    margin-top: 1.5rem;
    font-weight: 600;
    color: #4b3d2b;
  }

  .success-action {
    margin-top: 1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 0.8rem 1.6rem;
    background: #f0e4d3;
    color: #2e2214;
    text-decoration: none;
    font-weight: 600;
  }

  .status[data-tone="error"] {
    color: #8c3a2b;
  }

  .status[data-tone="success"] {
    color: #2f5a3a;
  }

  .meta {
    margin-top: 1.5rem;
    font-size: 0.9rem;
    color: #7a644b;
  }

  /* Success card */
  .success-card {
    text-align: center;
    padding: 1rem 0;
  }

  .tick-icon {
    width: 64px;
    height: 64px;
    margin-bottom: 1.25rem;
  }

  .tick-icon circle {
    stroke-dasharray: 157;
    stroke-dashoffset: 157;
    animation: draw-circle 0.5s ease forwards;
  }

  .tick-path {
    stroke-dasharray: 40;
    stroke-dashoffset: 40;
    animation: draw-tick 0.4s 0.35s ease forwards;
  }

  @keyframes draw-circle {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes draw-tick {
    to {
      stroke-dashoffset: 0;
    }
  }

  .success-title {
    margin: 0 0 0.5rem;
    font-size: 1.5rem;
    color: #2f5a3a;
  }

  .success-text {
    margin: 0 0 1.5rem;
    color: #4b3d2b;
    line-height: 1.5;
  }

  @media (max-width: 540px) {
    .card {
      padding: 2rem 1.5rem;
    }

    .input-wrap {
      flex-direction: column;
      align-items: stretch;
    }

    .ghost {
      align-self: flex-end;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .primary {
      transition: none;
    }
  }
</style>
